{
  "trailingSlash": true,
  "rewrites": [
    { "source": "/works", "destination": "/index.html" },
    { "source": "/works/", "destination": "/index.html" },
    { "source": "/drawing", "destination": "/index.html" },
    { "source": "/drawing/", "destination": "/index.html" },
    { "source": "/construction", "destination": "/index.html" },
    { "source": "/construction/", "destination": "/index.html" },
    { "source": "/name", "destination": "/index.html" },
    { "source": "/name/", "destination": "/index.html" },
    { "source": "/table", "destination": "/index.html" },
    { "source": "/table/", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/token.json", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/key.txt", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://bsc.publicnode.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
